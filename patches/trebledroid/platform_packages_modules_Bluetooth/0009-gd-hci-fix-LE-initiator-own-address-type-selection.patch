From db3c7e03fc7b0b7816c4c339de3e648810d33f84 Mon Sep 17 00:00:00 2001
From: Til Kaiser <mail@tk154.de>
Date: Sat, 14 Mar 2026 11:23:44 +0100
Subject: [PATCH] gd/hci: fix LE initiator own address type selection

Change-Id: I8d1d8ad8cde47f81f998cdd90b7f0b0020868268
---
 system/gd/hci/acl_manager/le_impl.h | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/system/gd/hci/acl_manager/le_impl.h b/system/gd/hci/acl_manager/le_impl.h
index 3d699bddf40aafbba3ebc38dfd7f4b4bd2264da7..3cadbf58cccb9f4e6ed368427e0c7e4ea90c066e 100644
--- a/system/gd/hci/acl_manager/le_impl.h
+++ b/system/gd/hci/acl_manager/le_impl.h
@@ -910,8 +910,12 @@ public:
     is_using_system_suspend_scan_params_ = system_suspend_;
 
     InitiatorFilterPolicy initiator_filter_policy = InitiatorFilterPolicy::USE_FILTER_ACCEPT_LIST;
-    OwnAddressType own_address_type = static_cast<OwnAddressType>(
-            le_address_manager_->GetInitiatorAddress().GetAddressType());
+    const AddressType address_type = le_address_manager_->GetInitiatorAddress().GetAddressType();
+    OwnAddressType own_address_type =
+            (address_type == AddressType::PUBLIC_DEVICE_ADDRESS ||
+             address_type == AddressType::PUBLIC_IDENTITY_ADDRESS)
+                    ? OwnAddressType::RESOLVABLE_OR_PUBLIC_ADDRESS
+                    : OwnAddressType::RESOLVABLE_OR_RANDOM_ADDRESS;
 
     uint16_t conn_interval_min;
     uint16_t conn_interval_max;
-- 
2.56.0

